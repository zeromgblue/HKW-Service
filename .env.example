# Firebase client SDK (used by Staff Auth in a later phase) — สร้างโปรเจกต์ที่
# https://console.firebase.google.com > Project settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only — used to create/read tickets securely).
# Project settings > Service accounts > Generate new private key, then copy
# the 3 fields below from the downloaded JSON file.
# IMPORTANT: keep the surrounding quotes and \n escapes in FIREBASE_PRIVATE_KEY as-is.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (image storage for ticket photos, server-only) — สมัครฟรีที่
# https://cloudinary.com/users/register/free แล้วคัดลอกค่าจาก Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push — generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
